{
  "name": "plataforma-eventos-api",
  "version": "1.0.0",
  "description": "API backend para una plataforma de eventos: autenticacion con JWT, roles, gestion de eventos, inscripciones con control de cupo y notificaciones por email.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/scripts/seed.js"
  },
  "keywords": [
    "api",
    "express",
    "mongodb",
    "jwt",
    "passport",
    "eventos"
  ],
  "author": "Franco Vitaller",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "nodemailer": "^6.9.14",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
