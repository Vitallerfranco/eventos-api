# ───────── Servidor ─────────
PORT=8080
NODE_ENV=development

# ───────── Base de datos ─────────
MONGO_URL=mongodb://localhost:27017/eventos
# Atlas: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/eventos

# ───────── JWT ─────────
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1d
JWT_COOKIE_NAME=authToken

# ───────── Nodemailer ─────────
# Con Gmail hay que usar una "contraseña de aplicacion", no la del correo.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_password_de_aplicacion
MAIL_FROM=Plataforma de Eventos <tu_correo@gmail.com>
